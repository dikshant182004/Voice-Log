# ==========================================
# Mini Call Log Service - Environment Configuration
# ==========================================

# --- Voice AI Providers (Free tiers & credits) ---
# Deepgram Streaming STT (Nova-3)
DEEPGRAM_API_KEY=

# Groq LLM (Llama 3.3 70B Versatile for lowest TTFB)
GROQ_API_KEY=

# Cartesia Streaming TTS (Sonic English)
CARTESIA_API_KEY=

# ElevenLabs Streaming TTS (optional fallback)
ELEVENLABS_API_KEY=

# --- Cloudflare Worker & D1 Storage ---
# Base URL of the deployed Cloudflare Worker API (e.g. https://mini-call-log-worker.<subdomain>.workers.dev)
WORKER_BASE_URL=http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787

# Ingest token for bot -> Worker authentication (Bearer auth)
INGEST_TOKEN=

# Allowed CORS origin (Cloudflare Pages URL or localhost in dev)
ALLOWED_ORIGIN=http://localhost:3000

# Cloudflare Credentials (for CI/CD GitHub Actions)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Pipecat Voice Bot Settings ---
BOT_HOST=0.0.0.0
BOT_PORT=8765
VITE_BOT_URL=http://localhost:8765

# Latency and Turn Detection Tunables
# Stop-silence threshold in seconds (0.2s - 0.4s recommended)
VAD_STOP_SECS=0.30
# Deepgram endpointing threshold in milliseconds (150ms - 300ms recommended)
ENDPOINTING_MS=200

# Safety Guardrails
# Maximum call duration before automatic hangup (prevents zombie credit burn)
MAX_CALL_SECONDS=600
# Silence idle timeout before disconnecting
IDLE_TIMEOUT_SECONDS=60
